# Clave de API de Groq para publicaciones botánicas automáticas (Miércoles y Jueves)
# Obtén tu clave en https://console.groq.com/keys
GROQ_API_KEY=

# Clave secreta para publicar artículos del autor en la sección "Publicaciones de Admin"
# Configura aquí tu clave privada en .env.local (por defecto: jardin2026 si no se define)
ADMIN_KEY=
